<?xml version="1.0" encoding="utf-8"?>
<!-- Google Play build: the messaging app and every tool, without self-update. Merged on top of
     src/main/AndroidManifest.xml.

     The removal below is a guard so that no library or future edit can merge the self-update
     permission back in unnoticed: Play forbids apps from updating themselves. -->
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />

</manifest>
