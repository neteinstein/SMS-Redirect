<?xml version="1.0" encoding="utf-8"?>
<!-- Google Play build: Backup and Restore only. Merged on top of src/main/AndroidManifest.xml.

     src/main no longer declares SEND_SMS; the removals below are a guard so that no library
     or future edit can merge these back in unnoticed. The Play SMS-permissions declaration
     covers "Backup and restore" only, and Play forbids self-updates. -->
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SEND_SMS"
        tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />

</manifest>
