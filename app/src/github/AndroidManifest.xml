<?xml version="1.0" encoding="utf-8"?>
<!-- GitHub-release build: every feature. Merged on top of src/main/AndroidManifest.xml. -->
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Redirect and Schedule send SMS. -->
    <uses-permission android:name="android.permission.SEND_SMS"
        tools:ignore="SmsAndCallLogPolicy" />

    <!-- In-app update: hands the APK downloaded from GitHub releases to the system installer.
         Never in the Play build: Play forbids self-updates and restricts this permission. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

</manifest>
