<?xml version="1.0" encoding="utf-8"?>
<!-- GitHub-release build: every feature plus self-update. Merged on top of src/main/AndroidManifest.xml. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- In-app update: hands the APK downloaded from GitHub releases to the system installer.
         Never in the Play build: Play forbids self-updates and restricts this permission. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

</manifest>
