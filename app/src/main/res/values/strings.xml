    <string name="app_name">SMS Toolbox</string>
    <string name="splash_subtitle">Back up, redirect and schedule your SMS</string>
    <string name="battery_optimization_title">Keep running in background</string>
    <string name="battery_optimization_message">SMS Toolbox needs to keep running in the background to forward messages and send scheduled SMS reliably. Disable battery optimization for this app so Android does not stop it.</string>
    <string name="action_cancel">Cancel</string>
