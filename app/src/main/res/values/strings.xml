    <string name="sideload_warning_title">Allow restricted settings</string>
    <string name="sideload_warning_message">This app was not installed via the Play Store. An extra step is required:\n\n1. Go to Settings > Apps > SMS Toolbox\n2. Tap the three-dot menu (top right)\n3. Select \"Allow restricted settings\"\n\nPress OK to open the app settings screen.</string>

    <string name="sms_permission_rationale_title">SMS permission needed</string>
    <string name="sms_permission_rationale_message">SMS Toolbox needs SMS permissions to read incoming text messages, back them up and forward or send them for you. MMS and RCS messages are out of scope and will not be forwarded or scheduled.</string>
    <string name="sms_permission_denied_title">Can\'t continue without SMS permission</string>
    <string name="sms_permission_denied_message">SMS Toolbox can\'t create redirects or scheduled messages without SMS permission. Grant the permission to continue.</string>

    <string name="contacts_permission_rationale_title">Contacts permission needed</string>
    <string name="contacts_permission_rationale_message">SMS Toolbox needs access to your contacts so you can pick a sender or target directly from your contact list instead of typing a number.</string>

    <string name="notifications_permission_rationale_title">Enable notifications?</string>
    <string name="notifications_permission_rationale_message">SMS Toolbox can show a notification whenever a message is backed up, forwarded or a scheduled SMS is sent, so you can confirm it went through.</string>

    <string name="battery_banner_message">Background running is not enabled. SMS forwarding and scheduled messages might not work reliably.</string>
    <string name="battery_banner_action">Fix now</string>

