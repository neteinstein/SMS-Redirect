<resources>
    <string name="app_name">SMS Toolbox</string>
    <string name="splash_subtitle">Guarde, redirecione e agende as suas SMS</string>
    <string name="battery_optimization_title">Manter em execução em segundo plano</string>
    <string name="battery_optimization_message">O SMS Toolbox precisa de continuar em execução em segundo plano para reencaminhar mensagens e enviar SMS agendados de forma fiável. Desative a otimização de bateria para esta app para que o Android não a interrompa.</string>
