<?xml version="1.0" encoding="utf-8"?>
<!-- Governs Android 12+ cloud backup and device-to-device transfer, mirroring the
     existing allowBackup="true" behavior (full backup of the Room database and
     SharedPreferences) for both mechanisms. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" />
        <include domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" />
        <include domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
